# Copy to .env (git-ignored) or run `uv run musical-agent setup`.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Create it in a project WITHOUT billing: free tier, zero cost. Over the limit the API
# returns 429 (rate limited), never a bill.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# Optional overrides. Defaults (shown) resolve paths from the project root.
# MODEL=gemini-3.5-flash-lite              (free tier: ~15 requests/min, ~500/day)
# AGENT_NOW=2026-03-25T10:00:00-04:00   (pins "now" for reproducible runs; empty = system clock)
# DATA_DIR=<project>/data               (CSVs and the store manual)
# SUPPORT_DIR=<project>/var             (complaints log)
# SESSION_DB_URL=sqlite+aiosqlite:///<project>/var/sessions.db   (created on first use)
# MODEL_ARMOR_TEMPLATE=                 (needs a GCP project with billing; empty = local screening)
# MAX_LLM_CALLS_PER_TURN=6              (loop guard per customer turn)
# MAX_MESSAGE_CHARS=2000
